# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Dedicated production PostgreSQL, Supabase or Neon DB connection string.
# Leave blank to automatically fall back to the safe local database file (db.json).
# Example: postgresql://postgres:mypassword@db.supabase.co:5432/postgres
DATABASE_URL=

# ADMIN MASTER CONTROL PANEL AUTHENTICATION
# Defaults to 226226 and 9988 if not specified. Change these in production!
ADMIN_PIN=226226
ADMIN_MFA=9988

